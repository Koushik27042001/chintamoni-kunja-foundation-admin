# Sri Sri Chintamoni Kunja Foundation — Server Environment Template

PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=

# Cloudinary Storage
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional AI LLM Provider (OpenAI-compatible; deterministic fallback active if blank)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Admin Portal Route
ADMIN_LOGIN_URL=/admin

# Client URL
CLIENT_URL=http://localhost:5173
